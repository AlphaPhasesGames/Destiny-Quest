    - target: {fileID: 2750354202815694749, guid: 67e37d9bfe6cf0843959ec09856e65b9, type: 3}
      propertyPath: m_text
      value: "America is destined to expand westward and claim new land. Our young
        nation didn\u2019t begin to grow through war \u2014 we grew with smart deals
        and brave settlers. t"
      objectReference: {fileID: 0}
